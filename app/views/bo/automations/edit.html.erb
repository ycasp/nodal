<% content_for :bo_main_content do %>

<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-start">
    <div class="d-flex align-items-center gap-3">
      <%= link_to bo_automation_path(current_organisation.slug, @automation), class: "text-muted text-decoration-none" do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>
      <div>
        <h1><%= @automation.name %></h1>
        <p><%= t('bo.automations.edit.subtitle') %></p>
      </div>
    </div>
    <div class="bo-page-actions">
      <%= button_to bo_automation_path(current_organisation.slug, @automation),
                    method: :delete, class: "btn btn-outline-danger",
                    form: { class: "d-inline", data: { turbo_confirm: t('bo.automations.form.delete_confirm') } } do %>
        <i class="fa-solid fa-trash"></i> <%= t('bo.common.actions.delete') %>
      <% end %>
      <%= link_to bo_automation_path(current_organisation.slug, @automation), class: "btn btn-outline-secondary" do %>
        <%= t('bo.common.actions.cancel') %>
      <% end %>
      <button type="submit" form="automation-form" class="btn btn-primary">
        <i class="fa-solid fa-check"></i> <%= t('bo.common.actions.save_changes') %>
      </button>
    </div>
  </div>
</div>

<div class="bo-page-body">
  <%= render "form", automation: @automation,
             url: bo_automation_path(current_organisation.slug, @automation), method: :patch %>
</div>

<% end %>
