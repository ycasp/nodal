<%# The blank row cloned by "add item". Shared by new and edit, which used to
    carry their own copy of this markup — and only one of them ever got fixed.
    Mirrors _order_items_fields; NEW_INDEX is swapped for a real index on clone. %>
<template data-order-items-target="template">
  <tr data-new-record="true">
    <td>
      <select name="order[order_items_attributes][NEW_INDEX][product_variant_id]"
              class="form-select form-select-sm"
              data-controller="tom-select"
              data-tom-select-url-value="<%= variant_search_bo_orders_path(params[:org_slug]) %>"
              data-action="change->order-items#variantChanged">
        <option value=""><%= t('bo.orders.form.select_product') %></option>
      </select>
      <input type="hidden" name="order[order_items_attributes][NEW_INDEX][product_id]">
      <textarea name="order[order_items_attributes][NEW_INDEX][note]" rows="1" maxlength="500"
                class="form-control form-control-sm mt-1"
                placeholder="<%= t('bo.orders.form.note_placeholder') %>"></textarea>
    </td>
    <td>
      <input type="number" name="order[order_items_attributes][NEW_INDEX][quantity]" class="form-control form-control-sm" value="1" min="1" data-quantity-field data-action="input->order-items#calculate">
    </td>
    <td>
      <div class="input-group input-group-sm">
        <span class="input-group-text"><%= @current_organisation.currency_symbol %></span>
        <input type="number" name="order[order_items_attributes][NEW_INDEX][price]" class="form-control form-control-sm" step="0.01" min="0" data-price-field data-action="input->order-items#calculate">
      </div>
    </td>
    <td>
      <div class="input-group input-group-sm">
        <input type="number" name="order[order_items_attributes][NEW_INDEX][discount_percent]" class="form-control form-control-sm" step="0.01" min="0" max="100" data-discount-field data-action="input->order-items#calculate">
        <span class="input-group-text">%</span>
      </div>
    </td>
    <td>
      <span class="fw-medium"><%= @current_organisation.currency_symbol %><span data-line-total>0.00</span></span>
    </td>
    <td>
      <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="order-items#remove">
        <i class="fa-solid fa-trash"></i>
      </button>
    </td>
  </tr>
</template>
