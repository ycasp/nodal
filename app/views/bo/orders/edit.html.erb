<% content_for :bo_main_content do%>

<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-start">
    <div class="d-flex align-items-center gap-3">
      <%= link_to bo_order_path(org_slug: @current_organisation.slug, id: @order.id, **filter_params_hash), class: "text-muted text-decoration-none" do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>
      <div>
        <h1><%= t('bo.orders.edit.title') %></h1>
        <p>
          <span class="fw-bold text-dark"><%= @order.order_number %></span>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="bo-page-body">
  <div class="row">
    <div class="col-lg-9">
      <%= form_with model: @order, url: bo_order_path(org_slug: @current_organisation.slug, id: @order.id, **filter_params_hash), method: :patch do |f| %>

        <% if @order.errors.any? %>
          <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><%= t('bo.common.fix_errors') %></h6>
            <ul class="mb-0">
              <% @order.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Order Details -->
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title mb-4"><%= t('bo.orders.show.order_details') %></h5>

            <div class="row mb-3">
              <div class="col-md-6">
                <label class="form-label"><%= t('bo.orders.form.order_number') %></label>
                <input type="text" class="form-control" value="<%= @order.order_number %>" disabled>
              </div>
              <div class="col-md-6">
                <label class="form-label"><%= t('bo.orders.form.customer') %></label>
                <input type="text" class="form-control" value="<%= @order.customer.company_name %>" disabled>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-md-4">
                <%= f.label :status, t('bo.common.tables.status'), class: "form-label" %>
                <%= f.select :status, Order::STATUSES.map { |s| [t("bo.common.statuses.#{s}"), s] }, {}, class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= f.label :payment_status, t('bo.orders.form.payment_status'), class: "form-label" %>
                <%= f.select :payment_status, Order::PAYMENT_STATUSES.map { |s| [t("bo.common.payment_statuses.#{s}"), s] }, {}, class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= f.label :receive_on, t('bo.orders.form.delivery_date'), class: "form-label" %>
                <%= f.date_field :receive_on, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :notes, t('bo.orders.form.order_notes'), class: "form-label" %>
              <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: t('bo.orders.form.notes_placeholder') %>
            </div>
          </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4" data-controller="order-items"
             data-order-items-currency-symbol-value="<%= @current_organisation.currency_symbol %>"
             data-order-items-pricing-url-value="<%= variant_pricing_bo_orders_path(params[:org_slug]) %>"
             data-order-items-customer-id-value="<%= @order.customer_id %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div>
                <h5 class="card-title mb-0"><%= t('bo.orders.show.order_items') %></h5>
                <p class="text-muted small mb-0"><%= t('bo.orders.show.items_count', count: @order.order_items.count) %></p>
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm" data-action="order-items#add">
                <i class="fa-solid fa-plus me-1"></i> <%= t('bo.orders.form.add_item') %>
              </button>
            </div>

            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width: 34%"><%= t('bo.common.product') %></th>
                    <th style="width: 12%"><%= t('bo.orders.form.quantity') %></th>
                    <th style="width: 18%"><%= t('bo.orders.form.unit_price') %></th>
                    <th style="width: 14%"><%= t('bo.orders.form.discount') %></th>
                    <th style="width: 17%"><%= t('bo.common.total') %></th>
                    <th style="width: 5%"></th>
                  </tr>
                </thead>
                <tbody data-order-items-target="container">
                  <%= f.fields_for :order_items do |item_form| %>
                    <%= render "order_items_fields", f: item_form %>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="border-top pt-3 mt-3">
              <div class="d-flex justify-content-end">
                <div class="text-end">
                  <span class="text-muted me-3"><%= t('bo.orders.form.order_total') %>:</span>
                  <strong class="fs-5"><%= @current_organisation.currency_symbol %><span data-order-items-target="total"><%= number_with_precision(@order.total_amount.to_f, precision: 2) %></span></strong>
                </div>
              </div>
            </div>
          </div>

          <%= render "order_item_template" %>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
          <%= f.submit t('bo.common.actions.save_changes'), class: "btn btn-primary" %>
          <%= link_to t('bo.common.actions.cancel'), bo_order_path(org_slug: @current_organisation.slug, id: @order.id, **filter_params_hash), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>

    <!-- Right Column -->
    <div class="col-lg-3">
      <!-- Client Information -->
      <div class="card mb-4">
        <div class="card-body">
          <h6 class="text-muted mb-3">
            <i class="fa-solid fa-user me-2"></i><%= t('bo.orders.show.client_information') %>
          </h6>

          <div class="mb-3">
            <small class="text-muted"><%= t('bo.orders.show.client_name') %></small>
            <div><%= @order.customer.contact_name %></div>
          </div>

          <div class="mb-3">
            <small class="text-muted"><%= t('bo.orders.show.company') %></small>
            <div><%= @order.customer.company_name %></div>
          </div>

          <div class="mb-2">
            <i class="fa-solid fa-envelope text-muted me-2"></i>
            <span><%= @order.customer.email %></span>
          </div>

          <% if @order.customer.contact_phone.present? %>
            <div class="mb-2">
              <i class="fa-solid fa-phone text-muted me-2"></i>
              <span><%= @order.customer.contact_phone %></span>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

<% end %>
