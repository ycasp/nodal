<% content_for :bo_main_content do%>

<div class="bo-page-header">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div class="d-flex align-items-center gap-3">
      <%= link_to bo_orders_path(org_slug: @current_organisation.slug), class: "text-muted text-decoration-none" do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>
      <div>
        <h1><%= t('bo.orders.new.title') %></h1>
        <p><%= t('bo.orders.new.subtitle') %></p>
      </div>
    </div>
  </div>
</div>

<div class="bo-page-body">

  <div class="row">
    <div class="col-lg-9">
      <%= form_with model: @order, url: bo_orders_path(org_slug: @current_organisation.slug), method: :post do |f| %>

        <% if @order.errors.any? %>
          <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><%= t('bo.common.fix_errors') %></h6>
            <ul class="mb-0">
              <% @order.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Customer Selection -->
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title mb-4"><%= t('bo.orders.form.customer') %></h5>
            <div class="mb-3">
              <%= f.label :customer_id, t('bo.orders.form.select_customer'), class: "form-label" %>
              <%= f.collection_select :customer_id, @customers, :id, :company_name, { prompt: t('bo.orders.form.choose_customer') }, { class: "form-select", data: { controller: "tom-select" } } %>
            </div>
          </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4" data-controller="order-items"
             data-order-items-pricing-url-value="<%= variant_pricing_bo_orders_path(params[:org_slug]) %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
              <h5 class="card-title mb-0"><%= t('bo.orders.show.order_items') %></h5>
              <button type="button" class="btn btn-outline-primary btn-sm" data-action="order-items#add">
                <i class="fa-solid fa-plus me-1"></i> <%= t('bo.orders.form.add_item') %>
              </button>
            </div>

            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="width: 34%"><%= t('bo.common.product') %></th>
                    <th style="width: 12%"><%= t('bo.orders.form.quantity') %></th>
                    <th style="width: 18%"><%= t('bo.orders.form.unit_price') %></th>
                    <th style="width: 14%"><%= t('bo.orders.form.discount') %></th>
                    <th style="width: 17%"><%= t('bo.common.total') %></th>
                    <th style="width: 5%"></th>
                  </tr>
                </thead>
                <tbody data-order-items-target="container">
                  <%= f.fields_for :order_items do |item_form| %>
                    <%= render "order_items_fields", f: item_form %>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="border-top pt-3 mt-3">
              <div class="d-flex justify-content-end">
                <div class="text-end">
                  <span class="text-muted me-3"><%= t('bo.orders.form.order_total') %>:</span>
                  <strong class="fs-5">$<span data-order-items-target="total">0.00</span></strong>
                </div>
              </div>
            </div>
          </div>

          <%= render "order_item_template" %>
        </div>

        <!-- Order Details -->
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title mb-4"><%= t('bo.orders.show.order_details') %></h5>

            <div class="row mb-3">
              <div class="col-md-4">
                <%= f.label :status, t('bo.common.tables.status'), class: "form-label" %>
                <%= f.select :status, Order::STATUSES.map { |s| [t("bo.common.statuses.#{s}"), s] }, { selected: "in_process" }, class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= f.label :payment_status, t('bo.orders.form.payment_status'), class: "form-label" %>
                <%= f.select :payment_status, Order::PAYMENT_STATUSES.map { |s| [t("bo.common.payment_statuses.#{s}"), s] }, { selected: "pending" }, class: "form-select" %>
              </div>
              <div class="col-md-4">
                <%= f.label :receive_on, t('bo.orders.form.expected_delivery_date'), class: "form-label" %>
                <%= f.date_field :receive_on, class: "form-control", value: 3.days.from_now.to_date %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :notes, t('bo.orders.form.order_notes'), class: "form-label" %>
              <%= f.text_area :notes, class: "form-control", rows: 3, placeholder: t('bo.orders.form.notes_placeholder') %>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
          <%= f.submit t('bo.orders.new.create_order'), class: "btn btn-primary" %>
          <%= link_to t('bo.common.actions.cancel'), bo_orders_path(org_slug: @current_organisation.slug), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% end %>
