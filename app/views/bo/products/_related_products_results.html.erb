<%# Results for the related-products picker. Only this frame reloads while the
    user types — the search input lives outside it, in related_products.html.erb. %>
<turbo-frame id="related_products_results">
  <% if params[:query].blank? && @results.any? %>
    <p class="text-muted small mb-2">
      <%= @suggestion == :same_category ? t('bo.products.related.same_category_hint') : t('bo.products.related.all_products_hint') %>
    </p>
  <% end %>

  <div style="max-height: 400px; overflow-y: auto;">
    <% if @results.any? %>
      <% @results.each do |product| %>
        <div class="d-flex align-items-center gap-3 p-2 mb-2 border rounded"
             data-related-products-target="availableItem"
             data-product-id="<%= product.id %>">
          <% if product.photo_attached? %>
            <%= image_tag product.photo, style: "width: 40px; height: 40px; object-fit: cover; border-radius: 4px;", loading: "lazy" %>
          <% else %>
            <div class="bg-secondary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 4px;">
              <i class="fa-solid fa-image text-white"></i>
            </div>
          <% end %>
          <div class="flex-grow-1">
            <strong><%= product.name %></strong>
            <small class="text-muted d-block"><%= [ product.sku, product.primary_category&.name ].compact_blank.join(" · ") %></small>
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary"
                  data-action="click->related-products#add"
                  data-product-id="<%= product.id %>"
                  data-product-name="<%= product.name %>"
                  data-product-category="<%= product.primary_category&.name %>"
                  data-product-image="<%= product.photo_attached? ? url_for(product.photo) : '' %>">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-4 text-muted">
        <p class="mb-0">
          <%= params[:query].present? ? t('bo.common.no_results', default: 'Sem resultados.') : t('bo.products.related.no_products_available') %>
        </p>
      </div>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="d-flex justify-content-center mt-3">
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
</turbo-frame>
