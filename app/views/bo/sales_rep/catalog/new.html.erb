<% content_for :bo_main_content do %>

<div class="bo-page-header">
  <div class="d-flex justify-content-between align-items-start">
    <div class="d-flex align-items-center gap-3">
      <%= link_to bo_path(params[:org_slug]), class: "text-muted text-decoration-none" do %>
        <i class="fa-solid fa-arrow-left fa-lg"></i>
      <% end %>
      <div>
        <h1>Gerar catálogo</h1>
        <p>Cria um catálogo PDF dos produtos para partilhares com os teus clientes.</p>
      </div>
    </div>
  </div>
</div>

<div class="bo-page-body">
  <div data-controller="catalog">
    <div class="card">
      <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <h5 class="mb-1"><i class="fa-solid fa-file-pdf text-primary me-2"></i>Catálogo em PDF</h5>
          <p class="text-muted mb-0 small">
            Escolhe os produtos ou categorias, ajusta as opções e gera o PDF. Fica pronto na página seguinte para descarregares.
          </p>
        </div>
        <div>
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#catalogModal">
            <i class="fa-solid fa-file-pdf me-1"></i> <%= t('bo.catalog.generate') %>
          </button>
        </div>
      </div>
    </div>

    <%= render "bo/shared/catalog_modal",
               generate_url: bo_sales_rep_catalog_path(params[:org_slug]),
               generate_method: :post %>
    <%= render "bo/shared/catalog_selection_modal",
               selection_url: bo_sales_rep_catalog_selection_path(params[:org_slug]) %>
  </div>
</div>

<% end %>
