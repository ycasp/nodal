<%# Cap the modal-content to the viewport height (vh-based, so it doesn't depend
    on the parent .modal having height:100%) and let the body flex-scroll. Header
    and footer stay pinned. !important defeats whatever overrides the Bootstrap
    scrollable rules on desktop. %>
<style>
  #catalogModal .modal-dialog {
    max-height: calc(100vh - 2rem) !important;
    margin: 1rem auto !important;
  }
  #catalogModal .modal-content {
    max-height: calc(100vh - 2rem) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
  }
  /* The form wraps modal-body + modal-footer, so it must be the flex column
     that fills the content and lets the body scroll. */
  #catalogModal .modal-content > form {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
  }
  #catalogModal .modal-header,
  #catalogModal .modal-footer { flex: 0 0 auto !important; }
  #catalogModal .modal-body {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
  }
</style>
<div class="modal fade" id="catalogModal" tabindex="-1" aria-labelledby="catalogModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <%# generate_url / method default to the admin products flow; the sales_rep
          catalog page overrides them to post to its own namespace. %>
      <% generate_url = local_assigns.fetch(:generate_url) { generate_catalog_bo_products_path(params[:org_slug]) } %>
      <% generate_method = local_assigns.fetch(:generate_method, :get) %>
      <%= form_with url: generate_url, method: generate_method, data: { turbo: false } do %>
        <div data-catalog-target="hiddenFields"></div>

        <div class="modal-header">
          <h5 class="modal-title" id="catalogModalLabel">
            <i class="fa-solid fa-file-pdf me-2"></i><%= t('bo.catalog.title') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <!-- Catalog style: functional vs premium -->
          <div class="mb-3 p-3 border rounded bg-light">
            <label class="form-label fw-semibold d-block mb-2">Estilo do catálogo</label>
            <div class="d-flex gap-4">
              <div class="form-check">
                <%= radio_button_tag :catalog_style, "functional", true, id: "style_functional", class: "form-check-input", data: { action: "change->catalog#applyStyle" } %>
                <%= label_tag :style_functional, "Funcional", class: "form-check-label fw-semibold" %>
                <div class="small text-muted">Grelha/lista compacta, variantes, códigos de barras.</div>
              </div>
              <div class="form-check">
                <%= radio_button_tag :catalog_style, "premium", false, id: "style_premium", class: "form-check-input", data: { action: "change->catalog#applyStyle" } %>
                <%= label_tag :style_premium, "Premium (exposição)", class: "form-check-label fw-semibold" %>
                <div class="small text-muted">Capa, fotos grandes, ar de catálogo de loja.</div>
              </div>
            </div>

            <div class="row g-2 mt-2 d-none" data-catalog-target="premiumOnly">
              <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Layout</label>
                <select name="premium_layout" class="form-select form-select-sm">
                  <option value="cards">3 produtos por página</option>
                  <option value="spread">1 produto por página</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Orientação</label>
                <select name="orientation" class="form-select form-select-sm">
                  <option value="landscape">Horizontal</option>
                  <option value="portrait">Vertical</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Subtítulo da capa</label>
                <%= text_field_tag :catalog_subtitle, nil, class: "form-control form-control-sm", placeholder: "ex.: Prata 925" %>
              </div>
            </div>
          </div>

          <div class="row">
            <!-- Title -->
            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold"><%= t('bo.catalog.catalog_title') %></label>
              <%= text_field_tag :catalog_title, current_organisation.name, class: "form-control form-control-sm", placeholder: t('bo.catalog.catalog_title_placeholder') %>
            </div>
            <!-- Client Name -->
            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold"><%= t('bo.catalog.client_name') %></label>
              <%= text_field_tag :client_name, nil, class: "form-control form-control-sm", placeholder: t('bo.catalog.client_name_placeholder') %>
            </div>
          </div>

          <!-- Observations -->
          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t('bo.catalog.observations') %></label>
            <%= text_area_tag :observations, nil, class: "form-control form-control-sm", rows: 3, placeholder: t('bo.catalog.observations_placeholder') %>
          </div>

          <!-- Layout & Sort -->
          <div class="row mb-3">
            <div class="col-6" data-catalog-target="functionalOnly">
              <label class="form-label fw-semibold"><%= t('bo.catalog.layout') %></label>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <%= radio_button_tag :catalog_layout, "grid", true, id: "layout_grid", class: "form-check-input" %>
                  <%= label_tag :layout_grid, t('bo.catalog.grid'), class: "form-check-label" %>
                </div>
                <div class="form-check">
                  <%= radio_button_tag :catalog_layout, "list", false, id: "layout_list", class: "form-check-input" %>
                  <%= label_tag :layout_list, t('bo.catalog.list'), class: "form-check-label" %>
                </div>
              </div>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold"><%= t('bo.catalog.sort_by') %></label>
              <select name="sort_by" class="form-select form-select-sm">
                <option value="name"><%= t('bo.catalog.sort_name') %></option>
                <option value="price"><%= t('bo.catalog.sort_price') %></option>
              </select>
            </div>
          </div>

          <div class="row">
          <!-- Options -->
          <div class="col-md-6 mb-3">
            <label class="form-label fw-semibold"><%= t('bo.catalog.options') %></label>
            <div class="form-check mb-1">
              <%= hidden_field_tag :show_prices, "0" %>
              <%= check_box_tag :show_prices, "1", true, class: "form-check-input", id: "catalog_show_prices" %>
              <%= label_tag :catalog_show_prices, t('bo.catalog.show_prices'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1">
              <%= check_box_tag :show_sku, "1", true, class: "form-check-input", id: "catalog_show_sku" %>
              <%= label_tag :catalog_show_sku, t('bo.catalog.show_sku'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1">
              <%= check_box_tag :show_barcode, "1", true, class: "form-check-input", id: "catalog_show_barcode" %>
              <%= label_tag :catalog_show_barcode, t('bo.catalog.show_barcode'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1">
              <%= check_box_tag :show_description, "1", false, class: "form-check-input", id: "catalog_show_description" %>
              <%= label_tag :catalog_show_description, t('bo.catalog.show_description'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1" data-catalog-target="functionalOnly">
              <%= check_box_tag :group_by_category, "1", true, class: "form-check-input", id: "catalog_group_by_category" %>
              <%= label_tag :catalog_group_by_category, t('bo.catalog.group_by_category'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1">
              <%= hidden_field_tag :only_available, "0" %>
              <%= check_box_tag :only_available, "1", true, class: "form-check-input", id: "catalog_only_available" %>
              <%= label_tag :catalog_only_available, t('bo.catalog.only_available'), class: "form-check-label" %>
            </div>
          </div>

          <!-- Variant Details -->
          <div class="col-md-6 mb-3" data-catalog-target="functionalOnly">
            <label class="form-label fw-semibold"><%= t('bo.catalog.variant_details') %></label>
            <div class="form-check mb-1">
              <%= check_box_tag :show_variants, "1", true, class: "form-check-input", id: "catalog_show_variants" %>
              <%= label_tag :catalog_show_variants, t('bo.catalog.show_variants'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1 ms-4">
              <%= hidden_field_tag :only_available_variants, "0" %>
              <%= check_box_tag :only_available_variants, "1", true, class: "form-check-input", id: "catalog_only_available_variants" %>
              <%= label_tag :catalog_only_available_variants, t('bo.catalog.only_available_variants'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1 ms-4">
              <%= check_box_tag :show_variant_sku, "1", true, class: "form-check-input", id: "catalog_show_variant_sku" %>
              <%= label_tag :catalog_show_variant_sku, t('bo.catalog.show_variant_sku'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1 ms-4">
              <%= check_box_tag :show_variant_price, "1", true, class: "form-check-input", id: "catalog_show_variant_price" %>
              <%= label_tag :catalog_show_variant_price, t('bo.catalog.show_variant_price'), class: "form-check-label" %>
            </div>
            <div class="form-check mb-1 ms-4">
              <%= check_box_tag :show_variant_photo, "1", true, class: "form-check-input", id: "catalog_show_variant_photo" %>
              <%= label_tag :catalog_show_variant_photo, t('bo.catalog.show_variant_photo'), class: "form-check-label" %>
            </div>
          </div>
          </div>

          <!-- Selection summary -->
          <div class="border rounded p-3 bg-light">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <i class="fa-solid fa-box me-1"></i>
                <strong data-catalog-target="settingsProductCount">0</strong> <%= t('bo.catalog.products_selected') %>
                &middot;
                <i class="fa-solid fa-folder me-1"></i>
                <strong data-catalog-target="settingsCategoryCount">0</strong> <%= t('bo.catalog.categories_selected') %>
              </div>
              <a href="#" class="btn btn-sm btn-outline-primary" data-action="click->catalog#openSelection">
                <i class="fa-solid fa-list-check me-1"></i><%= t('bo.catalog.define_content') %>
              </a>
            </div>
            <small class="text-muted"><%= t('bo.catalog.no_selection_hint') %></small>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <%= t('bo.common.actions.cancel') %>
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-file-pdf me-1"></i> <%= t('bo.catalog.generate') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
