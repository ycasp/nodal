<div class="modal fade" id="catalogSelectionModal" tabindex="-1" aria-labelledby="catalogSelectionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="catalogSelectionModalLabel">
          <i class="fa-solid fa-list-check me-2"></i><%= t('bo.catalog.selection.title') %>
        </h5>
        <button type="button" class="btn-close" data-action="click->catalog#doneSelecting"></button>
      </div>

      <div class="modal-body">
        <% selection_url = local_assigns.fetch(:selection_url) { catalog_selection_bo_products_path(params[:org_slug]) } %>

        <%# Search lives OUTSIDE the turbo-frame so the input is never re-rendered
            while typing — it keeps focus and value; only the results below reload.
            (Mirrors the storefront search bar; fixes dropped characters.) %>
        <div class="mb-3">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <%= form_with url: selection_url, method: :get, data: { turbo_frame: "catalog_selection" }, local: false, class: "flex-grow-1 d-flex" do %>
              <input type="text" name="query" class="form-control border-start-0"
                     placeholder="<%= t('bo.catalog.selection.search_placeholder') %>"
                     data-catalog-target="searchInput"
                     data-action="input->catalog#debouncedSearch"
                     autocomplete="off">
              <button type="button" class="btn btn-outline-secondary btn-sm"
                      data-action="click->catalog#clearSearch"
                      title="<%= t('bo.common.clear', default: 'Limpar') %>">
                <i class="fa-solid fa-times"></i>
              </button>
            <% end %>
          </div>
        </div>

        <turbo-frame id="catalog_selection"
                     data-catalog-target="selectionFrame"
                     data-src="<%= selection_url %>">
          <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
            <p class="text-muted small mt-2"><%= t('bo.common.loading', default: 'Loading...') %></p>
          </div>
        </turbo-frame>
      </div>

      <div class="modal-footer d-flex justify-content-between">
        <div class="text-muted small">
          <i class="fa-solid fa-box me-1"></i>
          <strong data-catalog-target="productCount">0</strong> <%= t('bo.catalog.products_selected') %>
          &middot;
          <i class="fa-solid fa-folder me-1"></i>
          <strong data-catalog-target="categoryCount">0</strong> <%= t('bo.catalog.categories_selected') %>
        </div>
        <button type="button" class="btn btn-primary" data-action="click->catalog#doneSelecting">
          <i class="fa-solid fa-check me-1"></i> <%= t('bo.catalog.selection.done') %>
        </button>
      </div>
    </div>
  </div>
</div>
