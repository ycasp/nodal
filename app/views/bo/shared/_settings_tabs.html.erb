<div class="card mb-4">
  <div class="card-body p-0">
    <ul class="nav nav-pills nav-fill border-bottom" role="tablist">
      <li class="nav-item" role="presentation">
        <%= link_to edit_bo_settings_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'settings'}" do %>
          <i class="fa-solid fa-gear me-2"></i><%= t('bo.settings.tabs.general', default: 'General') %>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to edit_bo_homepage_settings_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'homepage_settings'}" do %>
          <i class="fa-solid fa-house me-2"></i><%= t('bo.settings.tabs.homepage', default: 'Homepage') %>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to edit_bo_email_settings_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'email_settings'}" do %>
          <i class="fa-solid fa-envelope me-2"></i><%= t('bo.settings.tabs.email', default: 'Email') %>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to edit_bo_erp_settings_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'erp_settings'}" do %>
          <i class="fa-solid fa-plug me-2"></i><%= t('bo.settings.tabs.erp_integration', default: 'ERP Integration') %>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to bo_automations_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'automations'}" do %>
          <i class="fa-solid fa-robot me-2"></i><%= t('bo.settings.tabs.automations', default: 'Automations') %>
        <% end %>
      </li>
      <li class="nav-item" role="presentation">
        <%= link_to bo_background_tasks_path(params[:org_slug]),
            class: "nav-link rounded-0 py-3 #{'active' if controller_name == 'background_tasks'}" do %>
          <i class="fa-solid fa-list-check me-2"></i><%= t('bo.settings.tabs.tasks', default: 'Tasks') %>
          <% if @unseen_tasks_count && @unseen_tasks_count > 0 %>
            <span class="badge rounded-pill bg-primary ms-1"><%= @unseen_tasks_count %></span>
          <% end %>
        <% end %>
      </li>
    </ul>
  </div>
</div>
