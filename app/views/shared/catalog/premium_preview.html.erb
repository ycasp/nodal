<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= @catalog_title %> — pré-visualização</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:wght@400;500;600&family=Jost:wght@300;400;500&display=swap');

    :root {
      --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
      --display: "Playfair Display", Georgia, "Times New Roman", serif;
      --sans: "Jost", -apple-system, "Segoe UI", Roboto, sans-serif;
      --ink: #1c1a17;
      --meta: #9a938a;
      --gold: #a98953;
      --hairline: #e7e1d6;
      --paper: #ffffff;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--sans);
      color: var(--ink);
      background: #d9d5ce;
      -webkit-font-smoothing: antialiased;
    }

    /* ---- Screen: simulate stacked A4 sheets ---- */
    .sheet {
      position: relative;
      width: 210mm;
      min-height: 297mm;
      margin: 24px auto;
      background: var(--paper);
      box-shadow: 0 6px 30px rgba(0,0,0,0.18);
      overflow: hidden;
    }

    /* ---- Toolbar (screen only) ---- */
    .toolbar {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
      padding: 12px 20px;
      background: #1c1a17; color: #f4efe6;
      font-family: var(--sans); font-size: 13px;
    }
    .toolbar strong { font-weight: 500; letter-spacing: .04em; }
    .toolbar a {
      color: #f4efe6; text-decoration: none;
      padding: 5px 12px; border: 1px solid rgba(255,255,255,.25); border-radius: 999px;
      font-size: 12px; letter-spacing: .05em;
    }
    .toolbar a.active { background: #f4efe6; color: #1c1a17; border-color: #f4efe6; }
    .toolbar .spacer { flex: 1; }
    .toolbar .hint { color: #b9b1a3; font-size: 11px; }

    /* ================= COVER ================= */
    .cover { display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; height: 297mm; padding: 30mm; }
    .cover .org { font-family: var(--sans); font-size: 12px; letter-spacing: .35em; text-transform: uppercase; color: var(--meta); margin-bottom: 40px; }
    .cover .rule { width: 46px; height: 1px; background: var(--ink); margin: 26px auto; }
    .cover h1 { font-family: var(--serif); font-weight: 500; font-size: 62px; line-height: 1.05; letter-spacing: .01em; }
    .cover .subtitle { font-family: var(--serif); font-style: italic; font-size: 22px; color: #6b655c; margin-top: 14px; }
    .cover .foot { font-family: var(--sans); font-size: 11px; letter-spacing: .25em; text-transform: uppercase; color: var(--meta); margin-top: 46px; }

    /* ================= EDITORIAL (1 / page) ================= */
    .editorial { display: flex; flex-direction: column; height: 297mm; padding: 26mm 30mm; }
    .editorial .frame { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; }
    .editorial .frame img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .editorial .frame .ph { width: 60%; aspect-ratio: 1; background: #f2efe9; display: flex; align-items: center; justify-content: center; color: #cfc8bb; font-size: 40px; }
    .editorial .caption { text-align: center; padding-top: 30px; }
    .editorial .caption .cat { font-family: var(--sans); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--meta); }
    .editorial .caption h2 { font-family: var(--serif); font-weight: 500; font-size: 34px; margin: 12px 0 8px; }
    .editorial .caption .sku { font-family: var(--sans); font-size: 11px; letter-spacing: .12em; color: var(--meta); }
    .editorial .caption .price { font-family: var(--serif); font-size: 24px; margin-top: 14px; }

    /* ================= GRID (2-up) ================= */
    .grid { padding: 22mm 20mm; }
    .grid .grid-head { text-align: center; margin-bottom: 30px; }
    .grid .grid-head .cat { font-family: var(--sans); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--meta); }
    .grid .grid-head h2 { font-family: var(--serif); font-weight: 500; font-size: 30px; margin-top: 6px; }
    .grid .cells { display: grid; grid-template-columns: 1fr 1fr; gap: 20mm 16mm; }
    .grid .cell { text-align: center; page-break-inside: avoid; }
    .grid .cell .frame { height: 62mm; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .grid .cell .frame img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .grid .cell .frame .ph { width: 60%; height: 80%; background: #f2efe9; display: flex; align-items: center; justify-content: center; color: #cfc8bb; font-size: 30px; }
    .grid .cell h3 { font-family: var(--serif); font-weight: 500; font-size: 20px; line-height: 1.2; }
    .grid .cell .sku { font-family: var(--sans); font-size: 10px; letter-spacing: .12em; color: var(--meta); margin-top: 5px; }
    .grid .cell .price { font-family: var(--serif); font-size: 18px; margin-top: 8px; }

    /* ================= CLASSIC (cream + gold, 2x2) ================= */
    .classic { --ink:#2b2420; --meta:#9c8f78; --gold:#b3924f; background:#f7f2ea; padding: 22mm 22mm; height: 297mm; }
    .classic .grid-head { text-align: center; margin-bottom: 34px; }
    .classic .grid-head .orn { color: var(--gold); font-size: 16px; letter-spacing: .5em; }
    .classic .grid-head h2 { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); margin-top: 8px; }
    .classic .cells { display: grid; grid-template-columns: 1fr 1fr; gap: 22mm 18mm; }
    .classic .cell { text-align: center; page-break-inside: avoid; }
    .classic .cell .frame { height: 66mm; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .classic .cell .frame img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .classic .cell .frame .ph { width: 60%; height: 80%; background: #efe7d7; display: flex; align-items: center; justify-content: center; color: #d3c6ab; font-size: 30px; }
    .classic .cell h3 { font-family: var(--serif); font-weight: 500; font-size: 21px; color: var(--ink); }
    .classic .cell .divider { width: 30px; height: 1px; background: var(--gold); margin: 9px auto; }
    .classic .cell .sku { font-family: var(--sans); font-size: 10px; letter-spacing: .18em; color: var(--meta); text-transform: uppercase; }
    .classic .cell .price { font-family: var(--serif); font-size: 19px; color: var(--ink); margin-top: 8px; }
    .classic.cover-classic { display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; }
    .classic.cover-classic h1 { font-family: var(--serif); font-weight:500; font-size:60px; color:var(--ink); }
    .classic.cover-classic .org { font-family: var(--sans); font-size:12px; letter-spacing:.35em; text-transform:uppercase; color:var(--meta); margin-bottom:34px; }
    .classic.cover-classic .orn { color:var(--gold); font-size:20px; letter-spacing:.6em; margin:22px 0; }
    .classic.cover-classic .subtitle { font-family: var(--serif); font-style:italic; font-size:22px; color:#6f6350; margin-top:10px; }

    /* ================= SPREAD (reference-based hero) ================= */
    .sheet.landscape { width: 297mm; height: 210mm; min-height: auto; }
    .sheet.portrait  { width: 210mm; height: 297mm; min-height: auto; }
    .spread { display: flex; flex-direction: column; height: 100%; }

    .sp-header { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 7mm 12mm; border-bottom: 1px solid var(--hairline); }
    .sp-brand { display: flex; align-items: center; gap: 12px; }
    .sp-mono { width: 40px; height: 40px; border: 1.5px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--display); color: var(--gold); font-size: 20px; overflow: hidden; }
    .sp-mono img { width: 100%; height: 100%; object-fit: contain; }
    .sp-brand .name { font-family: var(--sans); font-size: 14px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); font-weight: 500; }
    .sp-brand .coll { font-family: var(--sans); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); margin-top: 3px; }
    .sp-pageno { display: flex; align-items: center; gap: 14px; }
    .sp-pageno .sect { font-family: var(--sans); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--meta); }
    .sp-pageno .bar { width: 1px; height: 22px; background: var(--hairline); }
    .sp-pageno .num { font-family: var(--display); font-size: 22px; color: var(--ink); }

    .sp-body { flex: 1; display: flex; min-height: 0; }
    .landscape .sp-body { flex-direction: row; }
    .landscape .sp-photo { width: 50%; }
    .landscape .sp-info { width: 50%; }
    .portrait .sp-body { flex-direction: column; }
    .portrait .sp-photo { width: 100%; height: 50%; }
    .portrait .sp-info { width: 100%; flex: 1; }

    .sp-photo { position: relative; background: #f4f1ec; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 10mm; }
    .sp-photo img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
    .sp-photo .ph { color: #cfc8bb; font-size: 48px; }
    .sp-tag { position: absolute; top: 0; left: 0; background: #fff; color: var(--ink); font-family: var(--sans); font-size: 12px; letter-spacing: .1em; padding: 6px 14px; }

    .sp-info { padding: 12mm; display: flex; flex-direction: column; }
    .sp-info h2 { font-family: var(--display); font-weight: 500; font-size: 40px; line-height: 1.08; color: var(--ink); }
    .sp-info .ref { font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--meta); margin-top: 10px; }

    .sp-badges { display: flex; gap: 26px; margin: 26px 0; }
    .sp-badge { text-align: center; width: 92px; }
    .sp-badge .circ { width: 46px; height: 46px; border: 1.5px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; color: var(--gold); }
    .sp-badge .circ svg { width: 20px; height: 20px; }
    .sp-badge .circ .txt { font-family: var(--display); font-size: 15px; color: var(--gold); letter-spacing: .02em; }
    .sp-badge .lbl { font-family: var(--sans); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); line-height: 1.3; }

    .sp-hair { height: 1px; background: var(--hairline); margin: 4px 0 16px; }
    .sp-desc { font-family: var(--serif); font-size: 16px; line-height: 1.5; color: #5b554c; }
    .sp-price { font-family: var(--display); font-size: 24px; color: var(--ink); margin-top: 14px; }

    .sp-cta { margin-top: auto; display: flex; justify-content: flex-end; }
    .sp-qr { border: 1px solid var(--hairline); border-radius: 10px; padding: 14px 18px; text-align: center; width: 152px; }
    .sp-qr .ph-ic { font-size: 18px; }
    .sp-qr .t1 { font-family: var(--sans); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; font-weight: 500; color: var(--ink); margin: 6px 0 2px; line-height: 1.3; }
    .sp-qr .t2 { font-family: var(--sans); font-size: 9px; color: var(--meta); margin-bottom: 8px; }
    .sp-qr svg { width: 96px; height: 96px; display: block; margin: 0 auto; }

    .sp-footer { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 5mm 12mm; border-top: 1px solid var(--hairline); }
    .sp-footer .fl { display: flex; align-items: center; gap: 10px; }
    .sp-footer .fl svg { width: 16px; height: 16px; color: var(--gold); }
    .sp-footer .fl .lbl { font-family: var(--sans); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); font-weight: 500; }
    .sp-footer .fl .url { font-family: var(--sans); font-size: 10px; color: var(--meta); }
    .sp-feats { display: flex; gap: 24px; }
    .sp-feat { display: flex; align-items: center; gap: 7px; font-family: var(--sans); font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: #6b655c; }
    .sp-feat svg { width: 15px; height: 15px; color: var(--gold); }
    .sp-edition { text-align: right; font-family: var(--sans); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--meta); line-height: 1.5; }

    /* ================= CARDS (3 / page — floating gallery) ================= */
    .cards-page { display: flex; flex-direction: column; height: 100%; }
    .sp-cards { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); min-height: 0; }
    .portrait .sp-cards { grid-template-columns: repeat(2, 1fr); }
    .sp-cell { display: flex; flex-direction: column; padding: 9mm 9mm 8mm; min-height: 0; }
    .sp-cell + .sp-cell { border-left: 1px solid var(--hairline); }
    .sp-sku { font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); font-weight: 500; line-height: 1; }
    .sp-sku::after { content: ""; display: block; width: 22px; height: 2px; background: var(--gold); margin-top: 8px; }
    .sp-cell h3 { font-family: var(--display); font-weight: 500; font-size: 25px; line-height: 1.14; color: var(--ink); margin-top: 14px; }
    .sp-cell-photo { flex: 1; display: flex; align-items: center; justify-content: center; padding: 7mm 2mm; min-height: 0; }
    .sp-cell-photo img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
    .sp-cell-photo .ph { color: #d8d1c4; font-size: 40px; }
    .sp-cell-hair { height: 1px; background: var(--hairline); margin: 4px 0 16px; }
    .sp-cell-attrs { display: flex; justify-content: space-around; gap: 12px; text-align: center; margin-bottom: 18px; }
    .sp-cell-attr .k { font-family: var(--sans); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
    .sp-cell-attr .v { font-family: var(--serif); font-size: 16px; color: var(--ink); margin-top: 5px; line-height: 1.15; }
    .sp-cell-barcode { text-align: center; margin: 4px 0 10px; }
    .sp-cell-barcode svg { height: 32px; width: auto; max-width: 100%; display: block; margin: 0 auto; }
    .sp-cell-barcode .bc-sku { font-family: var(--sans); font-size: 8px; letter-spacing: .14em; color: var(--meta); margin-top: 3px; }
    .sp-barcode { margin-top: 16px; }
    .sp-barcode svg { height: 44px; width: auto; max-width: 260px; display: block; }
    .sp-barcode .bc-sku { font-family: var(--sans); font-size: 9px; letter-spacing: .16em; color: var(--meta); margin-top: 4px; }
    .sp-cell-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .sp-ref { font-family: var(--sans); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink); font-weight: 500; }
    .sp-cell-price { font-family: var(--display); font-size: 17px; color: var(--ink); }

    /* ================= PREMIUM COVER + BACK COVER ================= */
    .pcover { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 30mm; }
    .pcover .mono { width: 66px; height: 66px; border: 1.5px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--display); color: var(--gold); font-size: 30px; overflow: hidden; margin-bottom: 26px; }
    .pcover .mono img { width: 100%; height: 100%; object-fit: contain; }
    .pcover .org { font-family: var(--sans); font-size: 13px; letter-spacing: .32em; text-transform: uppercase; color: var(--ink); }
    .pcover h1 { font-family: var(--display); font-weight: 500; font-size: 56px; line-height: 1.06; color: var(--ink); margin-top: 28px; }
    .pcover .sub { font-family: var(--serif); font-style: italic; font-size: 22px; color: #6b655c; margin-top: 12px; }
    .pcover .rule { width: 48px; height: 1px; background: var(--gold); margin: 28px 0; }
    .pcover .client { font-family: var(--sans); font-size: 14px; letter-spacing: .1em; color: var(--ink); }
    .pcover .date { font-family: var(--sans); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--meta); margin-top: 10px; }

    .pback { height: 100%; display: flex; flex-direction: column; padding: 24mm 26mm; }
    .pback h2 { font-family: var(--display); font-weight: 500; font-size: 30px; color: var(--ink); }
    .pback .gold-rule { width: 46px; height: 2px; background: var(--gold); margin: 12px 0 22px; }
    .pback .obs { font-family: var(--serif); font-size: 15px; line-height: 1.6; color: #5b554c; white-space: pre-wrap; margin-bottom: 36px; }
    .pback-grid { display: flex; gap: 60px; }
    .pback-block h3 { font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; }
    .pback-item { margin-bottom: 14px; }
    .pback-item .lbl { font-family: var(--sans); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--meta); }
    .pback-item .val { font-family: var(--serif); font-size: 15px; color: var(--ink); margin-top: 2px; line-height: 1.4; }

    /* footer with QR (cards) */
    .sp-footer--qr .fl-qr { display: flex; align-items: center; gap: 14px; }
    .sp-footer--qr .fl-qr .qr svg { width: 62px; height: 62px; display: block; }
    .sp-footer--qr .fl-qr .t1 { font-family: var(--sans); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 500; color: var(--ink); }
    .sp-footer--qr .fl-qr .t2 { font-family: var(--sans); font-size: 10px; color: var(--meta); margin-top: 3px; }
    .sp-footer--qr .fl-qr .t3 { font-family: var(--sans); font-size: 10px; color: var(--gold); margin-top: 2px; }

    /* portrait tightening */
    .portrait .sp-info { padding: 8mm 10mm; }
    .portrait .sp-info h2 { font-size: 32px; }
    .portrait .sp-badges { gap: 16px; margin: 16px 0; }
    .portrait .sp-badge { width: 84px; }
    .portrait .sp-qr { width: 132px; }
    .portrait .sp-feats { display: none; }

    <% if @orientation.to_s == "portrait" %>
    @page { size: 210mm 297mm; margin: 0; }
    <% else %>
    @page { size: 297mm 210mm; margin: 0; }
    <% end %>
    @media print {
      html, body { background: #fff; }
      .toolbar { display: none; }
      .sheet { margin: 0 !important; box-shadow: none; min-height: auto; overflow: hidden; page-break-after: always; }
      .sheet:last-child { page-break-after: auto; }
    }
  </style>
</head>
<body>
  <%
    photo_url = ->(product) do
      # In PDF mode the service passes an image_map of base64 data URIs so the
      # headless browser never fetches over HTTP.
      return @image_map[product.id] if @image_map && @image_map[product.id]
      return nil unless product.respond_to?(:photo_attached?)
      att = product.photo_attached? ? product.photo : product.display_photo
      return nil unless att
      polymorphic_url(att.variant(resize_to_limit: [1000, 1000]), host: @catalog_host)
    rescue StandardError
      nil
    end

    price_for = ->(product) do
      next nil unless @show_prices
      next "Sob consulta" if product.respond_to?(:price_on_request?) && product.price_on_request?
      product.display_price
    end

    cat_for = ->(product) { product.primary_category&.name || product.categories.first&.name }

    # Real, org-configured attributes for a product (max 4). Rule: show the
    # attribute NAME always; if it has a single value show it, if it has more
    # than one value across the product's variants show "Várias Opções".
    attrs_for = ->(product) do
      VariantAttributeValue
        .joins(product_variant: :product, product_attribute_value: :product_attribute)
        .where(product_variants: { product_id: product.id })
        .includes(product_attribute_value: :product_attribute)
        .map { |v| [v.product_attribute_value.product_attribute.name, v.product_attribute_value.value] }
        .group_by(&:first)
        .map do |name, pairs|
          vals = pairs.map(&:last).compact.uniq
          [name, vals.size == 1 ? vals.first : "Várias Opções"]
        end
        .first(4)
    rescue StandardError
      []
    end

    switch = ->(s) { "#{request.path}?#{request.query_parameters.merge('style' => s).to_query}" }

    logo_url = @logo_data.presence || begin
      @organisation.logo.attached? ? polymorphic_url(@organisation.logo.variant(resize_to_limit: [120, 120]), host: @catalog_host) : nil
    rescue StandardError
      nil
    end

    # QR points back to the product on the storefront — the bridge back to Nodal.
    # (Path is a best-effort mock; we wire the real storefront route when we ship.)
    product_url = ->(p) { "#{@catalog_host}/#{@organisation.slug}/products/#{p.slug}" }
    qr_svg = ->(url) do
      require "rqrcode"
      RQRCode::QRCode.new(url).as_svg(module_size: 3, standalone: true, use_path: true, viewbox: true, color: "1c1a17")
    rescue StandardError
      ""
    end

    ic_tag  ='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12l-8 8-9-9V3h8l9 9z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>'
    ic_box  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>'
    ic_cart = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M3 4h2l2.4 12h10L20 8H6"/></svg>'
    ic_globe= '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>'
    orientation = @orientation == "portrait" ? "portrait" : "landscape"
    show_sku = @show_sku.nil? ? true : !!@show_sku
    show_barcode = @show_barcode.nil? ? false : !!@show_barcode
  %>

  <% if @pdf_mode %>
    <style>body { background: #fff; } .sheet { margin: 0; box-shadow: none; }</style>
  <% end %>

  <% unless @pdf_mode %>
  <div class="toolbar">
    <strong>Catálogo Premium · pré-visualização</strong>
    <a href="<%= switch.call('spread') %>" class="<%= 'active' if @style == 'spread' %>">Spread (1/pág)</a>
    <a href="<%= switch.call('cards') %>" class="<%= 'active' if @style == 'cards' %>">Cards 3-up ★</a>
    <a href="<%= switch.call('editorial') %>" class="<%= 'active' if @style == 'editorial' %>">Editorial</a>
    <a href="<%= switch.call('grid') %>" class="<%= 'active' if @style == 'grid' %>">Grelha 2-up</a>
    <a href="<%= switch.call('classic') %>" class="<%= 'active' if @style == 'classic' %>">Clássico</a>
    <% if @style == "spread" %>
      <span class="hint">·</span>
      <a href="<%= "#{request.path}?#{request.query_parameters.merge('orient' => 'landscape').to_query}" %>" class="<%= 'active' if orientation == 'landscape' %>">Paisagem</a>
      <a href="<%= "#{request.path}?#{request.query_parameters.merge('orient' => 'portrait').to_query}" %>" class="<%= 'active' if orientation == 'portrait' %>">Retrato</a>
    <% end %>
    <span class="spacer"></span>
    <span class="hint"><%= @products.size %> produtos · Cmd+P para ver como PDF</span>
  </div>
  <% end %>

  <% page_offset = @page_offset.to_i %>
  <% if %w[spread cards].include?(@style) && [nil, "cover"].include?(@pdf_section) %>
    <%# ---------- PREMIUM COVER ---------- %>
    <div class="sheet <%= orientation %>">
      <div class="pcover">
        <div class="mono">
          <% if logo_url %><img src="<%= logo_url %>" alt=""><% else %><%= @organisation.name.to_s.strip.first&.upcase %><% end %>
        </div>
        <div class="org"><%= @organisation.name %></div>
        <h1><%= @catalog_title %></h1>
        <% if @catalog_subtitle %><div class="sub"><%= @catalog_subtitle %></div><% end %>
        <div class="rule"></div>
        <% if @client_name %><div class="client"><%= @client_name %></div><% end %>
        <div class="date"><%= l(Date.today, format: :long) rescue Date.today.strftime('%d/%m/%Y') %></div>
      </div>
    </div>
  <% end %>

  <% if [nil, "pages"].include?(@pdf_section) %>
  <% if @style == "cards" %>
    <%# ---------- CARDS (3 / page — floating gallery, QR in footer) ---------- %>
    <% per_page = orientation == "portrait" ? 4 : 3 %>
    <% @products.each_slice(per_page).with_index do |group, page_i| %>
      <% page_category = group.map { |p| cat_for.call(p) }.compact.first || @catalog_title %>
      <div class="sheet <%= orientation %>">
        <div class="cards-page">
          <div class="sp-header">
            <div class="sp-brand">
              <div class="sp-mono">
                <% if logo_url %><img src="<%= logo_url %>" alt=""><% else %><%= @organisation.name.to_s.strip.first&.upcase %><% end %>
              </div>
              <div>
                <div class="name"><%= @organisation.name %></div>
                <div class="coll"><%= @catalog_title %><% if @catalog_subtitle %> · <%= @catalog_subtitle %><% end %></div>
              </div>
            </div>
            <div class="sp-pageno">
              <span class="sect"><%= page_category.to_s.upcase %></span>
              <span class="bar"></span>
              <span class="num"><%= format('%02d', page_offset + page_i + 1) %></span>
            </div>
          </div>

          <div class="sp-cards">
            <% group.each do |product| %>
              <div class="sp-cell">
                <% if show_sku && product.sku.present? %><div class="sp-sku"><%= product.sku %></div><% else %><div class="sp-sku">&nbsp;</div><% end %>
                <h3><%= product.name %></h3>
                <div class="sp-cell-photo">
                  <% if (url = photo_url.call(product)) %>
                    <img src="<%= url %>" alt="<%= product.name %>">
                  <% else %>
                    <div class="ph">&#9671;</div>
                  <% end %>
                </div>
                <div class="sp-cell-hair"></div>
                <% pairs = attrs_for.call(product) %>
                <% if pairs.any? %>
                  <div class="sp-cell-attrs">
                    <% pairs.first(3).each do |k, v| %>
                      <div class="sp-cell-attr"><div class="k"><%= k %></div><div class="v"><%= v %></div></div>
                    <% end %>
                  </div>
                <% end %>
                <% if show_barcode && product.sku.present? && (bc = catalog_barcode_svg(product.sku)) %>
                  <div class="sp-cell-barcode"><%= bc %><div class="bc-sku"><%= product.sku %></div></div>
                <% end %>
                <% if (pr = price_for.call(product)) %>
                  <div class="sp-cell-foot"><span></span><span class="sp-cell-price"><%= pr %></span></div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="sp-footer sp-footer--qr">
            <div class="fl-qr">
              <div class="qr"><%= qr_svg.call("#{@catalog_host}/#{@organisation.slug}").html_safe %></div>
              <div>
                <div class="t1">Ver preços e disponibilidade</div>
                <div class="t2">Aceda ao Portal B2B</div>
                <div class="t3"><%= @catalog_host.to_s.sub(%r{^https?://}, '') %>/<%= @organisation.slug %></div>
              </div>
            </div>
            <div class="sp-feats">
              <span class="sp-feat"><%= ic_tag.html_safe %> Preços atualizados online</span>
              <span class="sp-feat"><%= ic_box.html_safe %> Disponibilidade em tempo real</span>
              <span class="sp-feat"><%= ic_cart.html_safe %> Encomendas 24/7</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

  <% elsif @style == "spread" %>
    <%# ---------- SPREAD (reference-based hero, 1 product / page) ---------- %>
    <% @products.each_with_index do |product, i| %>
      <div class="sheet <%= orientation %>">
        <div class="spread">
          <div class="sp-header">
            <div class="sp-brand">
              <div class="sp-mono">
                <% if logo_url %><img src="<%= logo_url %>" alt=""><% else %><%= @organisation.name.to_s.strip.first&.upcase %><% end %>
              </div>
              <div>
                <div class="name"><%= @organisation.name %></div>
                <div class="coll"><%= @catalog_title %><% if @catalog_subtitle %> · <%= @catalog_subtitle %><% end %></div>
              </div>
            </div>
            <div class="sp-pageno">
              <span class="sect"><%= (cat_for.call(product) || @catalog_title).to_s.upcase %></span>
              <span class="bar"></span>
              <span class="num"><%= format('%02d', page_offset + i + 1) %></span>
            </div>
          </div>

          <div class="sp-body">
            <div class="sp-photo">
              <% if (url = photo_url.call(product)) %>
                <img src="<%= url %>" alt="<%= product.name %>">
              <% else %>
                <div class="ph">&#9671;</div>
              <% end %>
              <% if show_sku && product.sku.present? %><span class="sp-tag"><%= product.sku %></span><% end %>
            </div>

            <div class="sp-info">
              <h2><%= product.name %></h2>
              <% if show_sku && product.sku.present? %><div class="ref">Referência <%= product.sku %></div><% end %>

              <% pairs = attrs_for.call(product) %>
              <% if pairs.any? %>
                <div class="sp-cell-attrs" style="justify-content:flex-start; gap:48px; margin:26px 0;">
                  <% pairs.each do |k, v| %>
                    <div class="sp-cell-attr" style="text-align:left;"><div class="k"><%= k %></div><div class="v"><%= v %></div></div>
                  <% end %>
                </div>
              <% end %>

              <div class="sp-hair"></div>

              <% if product.description.present? %>
                <div class="sp-desc"><%= truncate(product.description.to_s, length: 160) %></div>
              <% end %>
              <% if (pr = price_for.call(product)) %><div class="sp-price"><%= pr %></div><% end %>
              <% if show_barcode && product.sku.present? && (bc = catalog_barcode_svg(product.sku)) %>
                <div class="sp-barcode"><%= bc %><div class="bc-sku"><%= product.sku %></div></div>
              <% end %>

              <div class="sp-cta">
                <div class="sp-qr">
                  <div class="ph-ic">&#128241;</div>
                  <div class="t1">Ver preços e<br>disponibilidade</div>
                  <div class="t2">Aceda ao Portal B2B</div>
                  <%= qr_svg.call(product_url.call(product)).html_safe %>
                </div>
              </div>
            </div>
          </div>

          <div class="sp-footer">
            <div class="fl">
              <%= ic_globe.html_safe %>
              <div>
                <div class="lbl">Portal B2B</div>
                <div class="url"><%= @catalog_host.to_s.sub(%r{^https?://}, '') %>/<%= @organisation.slug %></div>
              </div>
            </div>
            <div class="sp-feats">
              <span class="sp-feat"><%= ic_tag.html_safe %> Preços atualizados online</span>
              <span class="sp-feat"><%= ic_box.html_safe %> Disponibilidade em tempo real</span>
              <span class="sp-feat"><%= ic_cart.html_safe %> Encomendas 24/7</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

  <% elsif @style == "classic" %>
    <%# ---------- CLASSIC ---------- %>
    <div class="sheet">
      <div class="classic cover-classic">
        <div class="org"><%= @organisation.name %></div>
        <div class="orn">&#10086;</div>
        <h1><%= @catalog_title %></h1>
        <% if @catalog_subtitle %><div class="subtitle"><%= @catalog_subtitle %></div><% end %>
        <div class="orn">&#10086;</div>
      </div>
    </div>
    <% @products.each_slice(4) do |group| %>
      <div class="sheet">
        <div class="classic">
          <div class="grid-head">
            <div class="orn">&#10086; &#10086; &#10086;</div>
            <h2><%= @catalog_title %></h2>
          </div>
          <div class="cells">
            <% group.each do |product| %>
              <div class="cell">
                <div class="frame">
                  <% if (url = photo_url.call(product)) %>
                    <img src="<%= url %>" alt="<%= product.name %>">
                  <% else %>
                    <div class="ph">&#9671;</div>
                  <% end %>
                </div>
                <h3><%= product.name %></h3>
                <div class="divider"></div>
                <% if product.sku.present? %><div class="sku"><%= product.sku %></div><% end %>
                <% if (pr = price_for.call(product)) %><div class="price"><%= pr %></div><% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  <% elsif @style == "editorial" %>
    <%# ---------- EDITORIAL ---------- %>
    <div class="sheet">
      <div class="cover">
        <div class="org"><%= @organisation.name %></div>
        <h1><%= @catalog_title %></h1>
        <% if @catalog_subtitle %><div class="subtitle"><%= @catalog_subtitle %></div><% end %>
        <div class="rule"></div>
        <div class="foot"><%= l(Date.today, format: :long) rescue Date.today.strftime("%d/%m/%Y") %></div>
      </div>
    </div>
    <% @products.each do |product| %>
      <div class="sheet">
        <div class="editorial">
          <div class="frame">
            <% if (url = photo_url.call(product)) %>
              <img src="<%= url %>" alt="<%= product.name %>">
            <% else %>
              <div class="ph">&#9671;</div>
            <% end %>
          </div>
          <div class="caption">
            <% if (c = cat_for.call(product)) %><div class="cat"><%= c %></div><% end %>
            <h2><%= product.name %></h2>
            <% if product.sku.present? %><div class="sku">Ref. <%= product.sku %></div><% end %>
            <% if (pr = price_for.call(product)) %><div class="price"><%= pr %></div><% end %>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>
    <%# ---------- GRID 2-up ---------- %>
    <div class="sheet">
      <div class="cover">
        <div class="org"><%= @organisation.name %></div>
        <h1><%= @catalog_title %></h1>
        <% if @catalog_subtitle %><div class="subtitle"><%= @catalog_subtitle %></div><% end %>
        <div class="rule"></div>
        <div class="foot"><%= l(Date.today, format: :long) rescue Date.today.strftime("%d/%m/%Y") %></div>
      </div>
    </div>
    <% @products.each_slice(6) do |group| %>
      <div class="sheet">
        <div class="grid">
          <div class="grid-head">
            <h2><%= @catalog_title %></h2>
          </div>
          <div class="cells">
            <% group.each do |product| %>
              <div class="cell">
                <div class="frame">
                  <% if (url = photo_url.call(product)) %>
                    <img src="<%= url %>" alt="<%= product.name %>">
                  <% else %>
                    <div class="ph">&#9671;</div>
                  <% end %>
                </div>
                <h3><%= product.name %></h3>
                <% if product.sku.present? %><div class="sku"><%= product.sku %></div><% end %>
                <% if (pr = price_for.call(product)) %><div class="price"><%= pr %></div><% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
  <% end %>

  <% if %w[spread cards].include?(@style) && [nil, "back"].include?(@pdf_section) && (@observations.present? || @organisation.has_contact_info?) %>
    <%# ---------- PREMIUM BACK COVER (observations + contacts) ---------- %>
    <div class="sheet <%= orientation %>">
      <div class="pback">
        <% if @observations.present? %>
          <h2><%= t('bo.catalog.pdf.observations') rescue 'Observações' %></h2>
          <div class="gold-rule"></div>
          <div class="obs"><%= @observations %></div>
        <% end %>

        <% if @organisation.has_contact_info? %>
          <h2><%= t('bo.catalog.pdf.contact_us') rescue 'Contactos' %></h2>
          <div class="gold-rule"></div>
          <div class="pback-grid">
            <div class="pback-block">
              <h3><%= t('bo.catalog.pdf.get_in_touch') rescue 'Fale connosco' %></h3>
              <% if @organisation.contact_email.present? %>
                <div class="pback-item"><div class="lbl">Email</div><div class="val"><%= @organisation.contact_email %></div></div>
              <% end %>
              <% if @organisation.phone.present? %>
                <div class="pback-item"><div class="lbl"><%= t('bo.catalog.pdf.phone') rescue 'Telefone' %></div><div class="val"><%= @organisation.phone %></div></div>
              <% end %>
              <% if @organisation.whatsapp.present? %>
                <div class="pback-item"><div class="lbl">WhatsApp</div><div class="val"><%= @organisation.whatsapp %></div></div>
              <% end %>
            </div>
            <div class="pback-block">
              <h3><%= t('bo.catalog.pdf.location_hours') rescue 'Localização & Horário' %></h3>
              <% address = @organisation.display_contact_address %>
              <% if address.present? %>
                <div class="pback-item"><div class="val">
                  <%= address.street_name %><% if address.street_nr.present? %> <%= address.street_nr %><% end %><br>
                  <%= address.postal_code %> <%= address.city %><br>
                  <%= address.country %>
                </div></div>
              <% end %>
              <% if @organisation.business_hours.present? %>
                <div class="pback-item"><div class="val"><%= @organisation.business_hours %></div></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</body>
</html>
